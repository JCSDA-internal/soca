input geometry: &geom
  geom_grid_file: soca_gridspec.nc
  mom6_input_nml: input.nml
  fields metadata: fields_metadata.yml

output geometry: *geom

variable change:
  variable change name: Soca2Cice
  arctic:
    rescale prior:
      rescale: true
  antarctic:
    seaice edge: 0.15
    shuffle: true
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
  cice background state:
    restart: {{BKG_CICE_RESTART}}
    ncat: {{NCAT}}
    ice_lev: {{ICE_LEV}}
    sno_lev: {{SNO_LEV}}
  cice output:
    restart: {{OUT_LEGACY}}
  output variables: &soca_vars
  - sea_water_potential_temperature
  - sea_water_salinity
  - sea_water_cell_thickness
  - sea_ice_area_fraction
  - sea_ice_thickness
  - sea_ice_snow_thickness

states:
- input:
     read_from_file: 1
     basename: ./
     ocn_filename: {{OCN_ANALYSIS}}
     ice_filename: {{ICE_ANALYSIS}}
     date: &an_date {{ANALYSIS_DATE}}
     state variables: *soca_vars
  output:
     datadir: ./
     exp: soca2cice_legacy
     type: an
     date: *an_date
