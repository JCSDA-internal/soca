geometry: &geom
  geom_grid_file: soca_gridspec.nc
  mom6_input_nml: input.nml
  fields metadata: fields_metadata.yml

restart:
  read_from_file: 1
  basename: ./
  ice_filename: {{BKG_CICE_RESTART_BASENAME}}
  ocn_filename: {{BKG_MOM_RESTART_BASENAME}}
  date: {{BKG_DATE}}
  state variables:
  - sea_ice_category1_area_fraction
  - sea_ice_category2_area_fraction
  - sea_ice_category3_area_fraction
  - sea_ice_category4_area_fraction
  - sea_ice_category5_area_fraction
  - sea_ice_category1_volume
  - sea_ice_category2_volume
  - sea_ice_category3_volume
  - sea_ice_category4_volume
  - sea_ice_category5_volume
  - sea_ice_snow_category1_volume
  - sea_ice_snow_category2_volume
  - sea_ice_snow_category3_volume
  - sea_ice_snow_category4_volume
  - sea_ice_snow_category5_volume
  - sea_water_potential_temperature
  - sea_water_salinity

restart output:
  datadir: ./
  exp: soca2cice_new
  type: an

analysis:
  read_from_file: 1
  basename: ./
  ocn_filename: {{OCN_ANALYSIS}}
  ice_filename: {{ICE_ANALYSIS}}
  date: {{ANALYSIS_DATE}}
  state variables:
  - sea_water_potential_temperature
  - sea_water_salinity
  - sea_water_cell_thickness
  - sea_ice_area_fraction
  - sea_ice_thickness
  - sea_ice_snow_thickness

postprocess ice:
  ncat: {{NCAT}}
  ice_lev: {{ICE_LEV}}
  sno_lev: {{SNO_LEV}}
  cice restart:
    input:  {{BKG_CICE_RESTART}}
    output: {{OUT_NEW}}
  arctic:
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
  antarctic:
    seaice edge: 0.15
    shuffle: true
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
