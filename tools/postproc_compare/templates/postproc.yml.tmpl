geometry: &geom
  geom_grid_file: soca_gridspec.nc
  mom6_input_nml: input.nml
  fields metadata: fields_metadata.yml

# Full analysis state on the soca grid (ocean + aggregate ice).
# Postproc.h uses this directly; PostProcessIce reads the CICE restart
# itself from the `postprocess ice: cice restart:` block below.
analysis:
  read_from_file: 1
  basename: ./
  ocn_filename: {{OCN_ANALYSIS}}
  ice_filename: {{ICE_ANALYSIS}}
  date: {{ANALYSIS_DATE}}
  state variables:
  - sea_water_potential_temperature
  - sea_water_salinity
  - sea_water_cell_thickness
  - sea_ice_area_fraction
  - sea_ice_thickness
  - sea_ice_snow_thickness

postprocess ice:
  ncat: {{NCAT}}
  ice_lev: {{ICE_LEV}}
  sno_lev: {{SNO_LEV}}
  cice restart:
    input:  {{BKG_CICE_RESTART}}
    output: {{OUT_NEW}}
  arctic:
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
  antarctic:
    seaice edge: 0.15
    shuffle: true
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
